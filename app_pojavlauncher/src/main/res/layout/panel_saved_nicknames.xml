<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/direct_nicknames_panel"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#F20A1711" android:visibility="gone" android:clickable="true" android:focusable="true">
    <ScrollView android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_margin="16dp" android:background="@drawable/direct_launch_card"
        app:layout_constraintWidth_max="380dp" app:layout_constrainedHeight="true"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp" android:focusableInTouchMode="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="@string/direct_saved_nicknames" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" />
                <ImageButton android:id="@+id/direct_nicknames_close" android:layout_width="48dp" android:layout_height="48dp"
                    android:padding="14dp" android:scaleType="fitCenter" android:src="@drawable/ic_nickname_close"
                    android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/direct_nickname_close" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp">
                <EditText android:id="@+id/direct_nickname_editor" android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_weight="1" android:layout_marginEnd="8dp" android:background="@drawable/direct_launch_input"
                    android:hint="@string/direct_launch_nickname_hint" android:inputType="textVisiblePassword" android:imeOptions="actionDone"
                    android:maxLength="16" android:singleLine="true" android:textSize="15sp" android:textColor="#FFFFFF" android:textColorHint="#BBD0C2" />
                <Button android:id="@+id/direct_nickname_save" android:layout_width="96dp" android:layout_height="match_parent"
                    android:minWidth="0dp" android:background="@drawable/direct_launch_button_background"
                    android:text="@string/direct_nickname_save" android:textAllCaps="false" android:textSize="13sp" android:textColor="#FFFFFF" />
            </LinearLayout>
            <TextView android:id="@+id/direct_nickname_error" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:textColor="#FFAAA2" android:textSize="12sp" android:visibility="gone" android:accessibilityLiveRegion="polite" />
            <LinearLayout android:id="@+id/direct_nickname_delete_confirmation" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical" android:visibility="gone">
                <TextView android:id="@+id/direct_nickname_delete_text" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textColor="#FFAAA2" android:textSize="13sp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="4dp">
                    <Button android:id="@+id/direct_nickname_delete_confirm" android:layout_width="0dp" android:layout_height="match_parent"
                        android:layout_weight="1" android:text="@string/direct_nickname_delete" android:textAllCaps="false" android:textColor="#FFAAA2"
                        android:background="?attr/selectableItemBackground" />
                    <Button android:id="@+id/direct_nickname_delete_cancel" android:layout_width="0dp" android:layout_height="match_parent"
                        android:layout_weight="1" android:text="@android:string/cancel" android:textAllCaps="false" android:textColor="#BBD0C2"
                        android:background="?attr/selectableItemBackground" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:id="@+id/direct_nickname_list" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:orientation="vertical" />
            <TextView android:id="@+id/direct_nickname_empty" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:paddingTop="12dp" android:paddingBottom="4dp" android:text="@string/direct_nickname_empty"
                android:textColor="#BBD0C2" android:textSize="13sp" android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
